# Copy to <install dir>/.env (next to docker-compose.yml). Paths must match console.toml.
CONSOLE_UID=1000                                   # id -u of the user that runs the runner and the collector
CONSOLE_GID=1000                                   # id -g of that user
CONSOLE_PORT=8097                                  # local port; Tailscale Serve publishes it on the tailnet
CONSOLE_WEB_DIR=/var/lib/agent-console/web         # [paths] web
CONSOLE_RUN_DIR=/var/lib/agent-console/run         # folder of [console] runner_sock
CONSOLE_STATE_DIR=/var/lib/agent-console/state     # folder of [console] passkeys
